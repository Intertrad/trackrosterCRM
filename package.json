{
  "name": "trackroster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:migrations:check": "node scripts/check-migration-integrity.mjs",
    "db:schema:check": "node scripts/check-live-schema.mjs",
    "db:migrations:recovery-check": "node scripts/check-migration-recovery.mjs",
    "check:production-config": "node scripts/check-production-config.mjs",
    "check:localization": "node scripts/check-localization-parity.mjs",
    "check:api-routes": "node scripts/check-api-route-ledger.mjs",
    "check:api-route-dispositions": "node scripts/check-api-route-dispositions.mjs",
    "check:release-evidence": "node scripts/check-release-evidence.mjs",
    "check:performance-budgets": "node scripts/check-performance-budgets.mjs",
    "performance:baseline": "node scripts/run-performance-baseline.mjs",
    "maps:serve": "http-server infrastructure/maps -p 8787 --cors -c-1",
    "maps:check": "node scripts/check-pmtiles.mjs",
    "geocode:prospects": "node scripts/geocode-missing-prospects.mjs",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "verify:backup": "node scripts/verify-postgres-backup.mjs",
    "check:database-pool-concurrency": "node scripts/check-database-pool-concurrency.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:api-routes && pnpm check:api-route-dispositions && pnpm check:localization && pnpm check:release-evidence && pnpm check:performance-budgets",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
