# Server-only URL used by the Next.js application to reach the NestJS API.
# Do NOT expose this as NEXT_PUBLIC_*.
TRACKROSTER_API_URL=http://127.0.0.1:3001

# Public MapLibre style URL for the TrackRoster basemap. OpenFreeMap Liberty is
# the default when this variable is omitted.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional legacy Protomaps archive configuration. The current map path uses
# NEXT_PUBLIC_MAP_STYLE_URL directly; keep this value only for PMTiles tooling
# or a future self-hosted style.
NEXT_PUBLIC_PMTILES_URL=
