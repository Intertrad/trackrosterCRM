# Server-only URL used by the Next.js application to reach the NestJS API.
# Do NOT expose this as NEXT_PUBLIC_*.
TRACKROSTER_API_URL=http://127.0.0.1:3001

# Public URL of the Protomaps basemap archive (a single .pmtiles file).
#
# Serve it from infrastructure you control so prospect coordinates are never
# sent to a third-party tile host. The host must support HTTP range requests.
#
# Build a France extract once with the Protomaps CLI, upload it to the object
# storage already in the architecture, then point this at it. Maps render the
# "not configured" state until it is set.
#
# NEXT_PUBLIC_PMTILES_URL=https://storage.example.com/basemaps/france.pmtiles
NEXT_PUBLIC_PMTILES_URL=
