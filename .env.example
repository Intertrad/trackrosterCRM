# Three connections, on purpose (TR-901).
#
# Row-Level Security does not apply to a table's owner unless FORCE ROW LEVEL
# SECURITY is set (migration 0073 now sets it), and the owner `trackroster`
# additionally holds SUPERUSER and BYPASSRLS, which bypasses RLS regardless.
# So while the API connected as the owner, every tenant policy created by
# migration 0071 was inert and tenant isolation rested on application
# predicates alone.
#
# The API therefore connects as `trackroster_app`: not the owner, not
# SUPERUSER, not BYPASSRLS, so the policies apply to it with no further
# configuration. It has no DDL rights, which is why migrations and test
# fixtures get their own owner URLs rather than reusing DATABASE_URL.
# See infrastructure/docker/postgres/init/01-runtime-role.sql.
#
# Verify the split is live:
#   psql "$DATABASE_URL" -c 'select count(*) from organizations'   -- 0
#   psql "$DATABASE_MIGRATION_URL" -c 'select count(*) from organizations'
DATABASE_URL=postgresql://trackroster_app:trackroster_app@127.0.0.1:5433/trackroster?sslmode=disable
# Set to false only for local/test TLS endpoints with a self-signed chain.
# Keep true (or unset) in production and use a trusted CA certificate.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Owner. DDL only — drizzle-kit reads this (apps/api/drizzle.config.ts).
DATABASE_MIGRATION_URL=postgresql://trackroster:trackroster@127.0.0.1:5433/trackroster?sslmode=disable

# Owner. Integration fixtures only (apps/api/test/support/seed.ts): suites seed
# across several tenants before any request, which the application is
# correctly not allowed to do. Everything asserted through the app still
# crosses the real RLS path.
DATABASE_SEED_URL=postgresql://trackroster:trackroster@127.0.0.1:5433/trackroster?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET= 7bJXOEtKewtxNwS3ioJjaDccSsgbXMamUnO5e8/lX7Rj6ECn7SiqacdbsE4+QmpV
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=htkgJa9bfG8yd6TFlm6dujp/lZE8ErGH0jJZ/hxWBCjAXJC5whBIkohfzzoKzx7z
JWT_REFRESH_TTL=7d
DEV_ADMIN_PASSWORD=admin
NODE_ENV=development
PROSPECT_COOLING_OFF_MINUTES=1440
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FORCE_PATH_STYLE=false
COMPLIANCE_DOWNLOAD_SECRET=

# REQUIRED TO BOOT.
#
# AuthMailService validates these in onModuleInit and throws
# ServiceUnavailableException('Account email is not configured') when either is
# absent, so the API exits on startup rather than degrading. They were listed
# as optional, which is how an environment missing them looks like a working
# one until the process refuses to come up.
#
# Generate a private 32-byte key; never use the synthetic integration-test key.
MFA_ENCRYPTION_KEY=<64 hex characters>
# Use the local URL for development. Production must use the public HTTPS app origin,
# for example https://trackroaster.com.
AUTH_PUBLIC_ORIGIN=http://localhost:3000

# One mail path is required: a local mailbox or a Brevo key. Without either,
# password recovery and invitation delivery silently do nothing, and the
# integration suites that read the mailbox cannot pass.
MAILPIT_URL=http://127.0.0.1:58025
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# PUSH_PROVIDER_URL=
# PUSH_PROVIDER_API_KEY=
# Required for OneSignal's /notifications endpoint.
# PUSH_PROVIDER_APP_ID=

# Daily inactivity notification digest. The scheduler enqueues one tenant-scoped
# job after this UTC hour; the deterministic job id keeps retries idempotent.
# NOTIFICATION_DIGEST_HOUR_UTC=8
# NOTIFICATION_INACTIVITY_DAYS=7
# NOTIFICATION_DIGEST_POLL_INTERVAL_MS=60000
# NOTIFICATION_DIGEST_SCHEDULER=off

# Optional. OIDC connection secret storage (configuration only; the sign-in
# flow remains pending). Required only by the security-policy endpoints.
# SSO_ENCRYPTION_KEY=<64 hex characters>
